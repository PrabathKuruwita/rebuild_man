# Django Settings
# Generate a new secure SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-generated-secret-key-here
DEBUG=False

# List of allowed hosts (comma-separated, no spaces after commas)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Configuration - PostgreSQL
# IMPORTANT: Use strong password with mix of upper, lower, numbers, and special chars
DB_NAME=rebuild_db
DB_USER=postgres
DB_PASSWORD=your-secure-database-password-here
DB_HOST=db
DB_PORT=5432

# Google Gemini Configuration (for AI/OCR processing)
# Get your FREE API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend Configuration
# URL of your frontend application (used for password reset emails and CORS) - MUST USE HTTPS in production
FRONTEND_URL=https://your-domain.com

# CORS Settings (comma-separated origins, no spaces)
# IMPORTANT: List only trusted domains. DO NOT use wildcards or *
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# CSRF Trusted Origins (comma-separated origins, no spaces)
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Email Configuration (for password reset emails and notifications)
# In development: django.core.mail.backends.console.EmailBackend (prints to console)
# In production: django.core.mail.backends.smtp.EmailBackend (sends via SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Optional: Celery/Redis (for background tasks)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
